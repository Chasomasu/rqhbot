# RqhBot 环境变量配置
# 复制此文件为 sdk/.env 并填入实际配置（.env 已被 git 忽略）
# 注意：本文件由 sdk/config/config.py 加载，必须放在 sdk/ 目录下

# 连接配置（环境变量为可选覆盖项；未设置时按 config.yaml 的 adapter 选择后端默认地址）
# Windows 注意：localhost 可能优先解析为 IPv6 (::1)，建议直接写 127.0.0.1
NAPCAT_WS_URL=ws://127.0.0.1:3002
# 访问令牌（从所选后端 NapCat / SnowLuma 获取）
NAPCAT_ACCESS_TOKEN=

# 日志配置
# 级别可选：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_DIR=logs

# 调试模式：true / false
BOT_DEBUG=false
